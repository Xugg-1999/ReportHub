@model Category
@{
    ViewData["Title"] = "编辑分类";
}

<div class="rh-admin-head">
    <div>
        <h1 class="rh-admin-title">编辑分类</h1>
        <p class="rh-admin-sub">@Model.Name</p>
    </div>
    <a class="btn rh-btn-outline" asp-action="Index">返回列表</a>
</div>

<div class="rh-form-card">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <partial name="_CategoryForm" model="Model" />
        <div class="rh-form-actions">
            <button type="submit" class="btn rh-btn-primary">保存</button>
            <a asp-action="Index" class="btn btn-link">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
