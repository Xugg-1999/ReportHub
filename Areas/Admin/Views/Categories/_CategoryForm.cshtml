@model Category

<div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label">分类名称</label>
        <input asp-for="Name" class="form-control" placeholder="例如：财务报表" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SortOrder" class="form-label">排序号</label>
        <input asp-for="SortOrder" class="form-control" type="number" />
        <div class="form-text">数值越小越靠前</div>
        <span asp-validation-for="SortOrder" class="text-danger small"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label">分类说明</label>
        <textarea asp-for="Description" class="form-control" rows="2" placeholder="可选"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
