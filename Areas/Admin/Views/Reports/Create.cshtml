@model Report
@{
    ViewData["Title"] = "新增报表";
}

<div class="rh-admin-head">
    <div>
        <h1 class="rh-admin-title">新增报表</h1>
        <p class="rh-admin-sub">填写帆软报表信息，保存后可在首页查看</p>
    </div>
    <a class="btn rh-btn-outline" asp-action="Index">返回列表</a>
</div>

<div class="rh-form-card">
    <form asp-action="Create" method="post">
        <partial name="_ReportForm" model="Model" />
        <div class="rh-form-actions">
            <button type="submit" class="btn rh-btn-primary">保存</button>
            <a asp-action="Index" class="btn btn-link">取消</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
