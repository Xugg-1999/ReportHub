@model Report
@{
    ViewData["Title"] = "删除报表";
}

<div class="rh-admin-head">
    <div>
        <h1 class="rh-admin-title">删除报表</h1>
        <p class="rh-admin-sub">删除后首页将不再展示该报表</p>
    </div>
    <a class="btn rh-btn-outline" asp-action="Index">返回列表</a>
</div>

<div class="rh-form-card">
    <div class="rh-notice rh-notice-danger mb-4">
        确认删除报表「<strong>@Model.Name</strong>」（分类：@Model.Category?.Name）？此操作不可撤销。
    </div>

    <dl class="row rh-detail-list mb-4">
        <dt class="col-sm-3">报表地址</dt>
        <dd class="col-sm-9 text-break">@Model.ReportUrl</dd>
        <dt class="col-sm-3">状态</dt>
        <dd class="col-sm-9">@(Model.IsActive ? "已启用" : "已停用")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">确认删除</button>
        <a asp-action="Index" class="btn btn-link">取消</a>
    </form>
</div>
