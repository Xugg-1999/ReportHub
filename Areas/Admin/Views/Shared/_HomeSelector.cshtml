@* 管理后台首页选择器：下拉切换不同首页的管理视图 *@
@{
    var homeList = ViewData["HomeList"] as SelectList;
    var currentHomeCode = ViewData["HomeCode"] as string;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

@if (homeList != null && !string.IsNullOrEmpty(controller))
{
    <form method="get" asp-controller="@controller" asp-action="@action" class="d-flex align-items-center gap-2 mb-3">
        <label class="rh-muted small mb-0">当前首页：</label>
        <select name="homeCode" class="form-select form-select-sm" style="max-width: 180px" onchange="this.form.submit()">
            @foreach (var item in homeList)
            {
                <option value="@item.Value" selected="@(item.Value?.ToString() == currentHomeCode ? "selected" : null)">@item.Text</option>
            }
        </select>
        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">切换</button></noscript>
    </form>
}
