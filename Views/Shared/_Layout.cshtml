<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReportHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReportHub.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light rh-navbar border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand rh-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="rh-brand-icon">📊</span> ReportHub
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 rh-home-nav">
                        @* 多个首页并列入口，当前页面的 homeCode 由控制器写入 ViewData*@
                        @foreach (var home in HomeDefinitions.All)
                        {
                            var active = (string?)ViewData["CurrentHomeCode"] == home.Code;
                            <li class="nav-item">
                                <a class="nav-link text-dark @(active ? "rh-home-active" : "")"
                                   asp-area="" asp-controller="Home" asp-action="Index"
                                   asp-route-homeCode="@home.Code">@home.DisplayName</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Admin" asp-controller="Reports" asp-action="Index">管理后台</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center gap-2">
                                <span class="navbar-text small">@User.Identity.Name</span>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">退出</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">管理员登录</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid px-4 d-flex flex-wrap align-items-center gap-2">
            <span>&copy; 2026 <a class="rh-footer-link" href="mailto:guangge_xu@outlook.com" title="Contact the author">ReportHub</a> - 企业内部报表导航</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
